# agent-skeleton-kit configuration.
# Copy to .env and set LLM_API_KEY. Everything else has a working default for docker compose.
#   cp .env.example .env

# --- LLM (any OpenAI-compatible chat completions API with tool calling) ---
LLM_BASE_URL=https://api.openai.com/v1
# Required. Never commit a real key.
LLM_API_KEY=
# Pick a model from your provider that supports tool calling.
LLM_MODEL=gpt-4o-mini

# --- Embeddings (OpenAI-compatible embeddings API) ---
# Leave EMBEDDING_BASE_URL empty to use the LLM endpoint.
# EMBEDDING_API_KEY falls back to LLM_API_KEY only when embeddings use the same host as the
# LLM. For a different host, set EMBEDDING_API_KEY explicitly, or leave it empty to send no
# key (for example a local Ollama at http://host.docker.internal:11434/v1).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model output. Changing model or dimensions requires reindexing.
EMBEDDING_DIMENSIONS=1536

# --- Infrastructure (defaults match docker-compose.yml service names) ---
MONGODB_URI=mongodb://mongo:27017/agent_skeleton?directConnection=true
REDIS_URL=redis://redis:6379
# For running the API on the host against compose services, publish the ports
# (see docker-compose.yml) and use localhost instead:
#   MONGODB_URI=mongodb://localhost:27017/agent_skeleton?directConnection=true
#   REDIS_URL=redis://localhost:6379

# --- Application ---
PORT=3000
# Directory containing one subdirectory per tenant.
TENANTS_DIR=./examples
# Ingest every tenant's knowledge/ directory when the API starts.
AUTO_INGEST=true
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Agent loop limits ---
MAX_TOOL_ITERATIONS=5
TOOL_TIMEOUT_MS=10000
